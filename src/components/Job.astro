---
import type { Job as JobData } from "@/data/resume";
import Project from "@/components/Project.astro";

interface Props {
  job: JobData;
}

const { job } = Astro.props;
---

<article class="border-l-2 border-primary/30 pl-5 sm:pl-7">
  <header class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
    <div>
      <h3 class="text-xl font-semibold tracking-tight text-fg">{job.role}</h3>
      <p class="font-medium text-primary">{job.company}</p>
    </div>
    <div class="shrink-0 text-left text-sm text-muted sm:text-right">
      <p>{job.startDate} — {job.endDate}</p>
      <p>{job.location}</p>
    </div>
  </header>

  <p class="mt-4 max-w-2xl leading-7 text-muted">{job.summary}</p>

  <ul class="mt-4 space-y-2 text-sm leading-6 text-fg">
    {job.highlights.map((highlight) => (
      <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-1.5 before:w-1.5 before:-translate-y-1/2 before:rounded-full before:bg-secondary">
        {highlight}
      </li>
    ))}
  </ul>

  {job.projects && job.projects.length > 0 && (
    <div class="mt-6 space-y-4 border-t border-border/70 pt-5">
      <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">Selected projects</h4>
      {job.projects.map((project) => <Project project={project} />)}
    </div>
  )}
</article>
