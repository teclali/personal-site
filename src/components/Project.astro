---
import type { Project as ProjectData } from "@/data/resume";

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
---

<article class="rounded-xl border border-border bg-surface/60 p-5 transition-colors hover:border-primary/50">
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-lg font-semibold tracking-tight text-fg">{project.name}</h3>
    {project.links && project.links.length > 0 && (
      <div class="flex shrink-0 gap-3 text-sm">
        {project.links.map((link) => (
          <a
            href={link.href}
            class="text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
  <p class="mt-2 text-sm leading-6 text-muted">{project.description}</p>
  <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${project.name} technologies`}>
    {project.technologies.map((technology) => (
      <li class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">{technology}</li>
    ))}
  </ul>
</article>
