---
import type { Project as ProjectData } from "@/data/resume";

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const links = [project.codeLink, project.projectLink].filter(Boolean);
---

<article class="border-b border-border/70 pb-5 last:border-b-0 last:pb-0">
  {project.images && project.images.length > 0 && (
    <div class="mb-5 grid gap-3 sm:grid-cols-2">
      {project.images.map((image) => (
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
          class="aspect-video w-full rounded-xl border border-border/70 object-cover"
        />
      ))}
    </div>
  )}

  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
    <h4 class="font-serif text-lg font-bold tracking-tight text-fg">{project.name}</h4>
    {links.length > 0 && (
      <nav aria-label={`${project.name} links`} class="flex shrink-0 flex-wrap gap-x-4 gap-y-1 text-sm">
        {links.map((link) => link && (
          <a
            href={link.href}
            class="text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    )}
  </div>

  <p class="mt-2 font-serif leading-6 text-fg">{project.description}</p>

  {project.technologies.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2" aria-label={`${project.name} technologies`}>
      {project.technologies.map((technology) => (
        <li class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{technology}</li>
      ))}
    </ul>
  )}
</article>
