---
import { Image } from 'astro:assets';
import portrait from '../assets/casey_strong_portrait_2.jpg';
import BasePage from './BasePage.astro';
import PageHeader from '@/components/PageHeader.astro';
---
<BasePage>
  <main class="mx-auto grid max-w-2xl grid-cols-1 px-6 md:grid-cols-3 md:gap-8">
    <div class="m-auto flex justify-center md:m-0">
      <Image src={portrait} width="200" height="300" alt="Portrait of Casey Strong" class="rounded-lg w-[200px] h-[300px] object-cover self-start"></Image>
    </div>
    <div class="h-full justify-center col-span-2 text-center md:text-left">
      <PageHeader title="Casey Strong" class="text-center md:text-left" />
      <slot />
    </div>
  </main>
</BasePage>
