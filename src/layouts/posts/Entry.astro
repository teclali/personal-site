---
import BasePage from "../BasePage.astro";
import PageHeader from "@/components/PageHeader.astro";
const { frontmatter } = Astro.props;
const datePublished = new Date(frontmatter.date_published);
const formattedDate = datePublished.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})
---
<BasePage>
  <div class="mx-auto max-w-xl px-8">
    <PageHeader title={frontmatter.title} class="text-left">
      <time class="mt-4 block" datetime={frontmatter.date_published}>{formattedDate}</time>
    </PageHeader>
  </div>
  <main class="m-auto max-w-xl px-8 text-xl *:mb-8">
    <slot />
  </main>
</BasePage>
