---
import BasePage from "@/layouts/BasePage.astro";
import Job from "@/components/Job.astro";
import { resumeData } from "@/data/resume";

const { jobs } = resumeData;
const technologies = [...new Set(jobs.flatMap((job) => job.projects.flatMap((project) => project.technologies)))].sort();
const linkedinUrl = "https://www.linkedin.com/in/casey-strong-2ba95b193/";
---

<BasePage>
  <main x-data="resumePage" class="mx-auto max-w-5xl px-5 pb-16 pt-12 text-fg sm:px-8 lg:px-12 lg:pt-24">
    <header class="mb-12 text-center" aria-labelledby="resume-heading">
      <h1 id="resume-heading" class="text-5xl font-medium text-primary sm:text-6xl">Resume</h1>
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 block text-right underline"
      >
        LinkedIn
      </a>
    </header>

    <div class="grid items-start gap-10 lg:grid-cols-[12rem_minmax(0,68ch)] lg:gap-14">
      <aside class="lg:sticky lg:top-8" aria-label="Experience navigation">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Jump to</p>
        <nav class="mt-3 space-y-2">
          {jobs.map((job, index) => (
            <details
              open={index === 0}
              data-job-nav={job.id}
              x-show={`hasMatchingProject('${job.id}')`}
              x-bind:open={`activeJob === '${job.id}'`}
              class="group rounded-lg border border-border/80 bg-bg/30 text-sm text-muted"
            >
              <summary
                x-on:click={`handleJobNavigation('${job.id}')`}
                class="flex cursor-pointer list-none items-start justify-between gap-2 rounded-lg px-3 py-2 leading-5 transition-colors hover:bg-surface hover:text-primary [&::-webkit-details-marker]:hidden"
              >
                <span>
                  <span class="block font-medium text-fg group-hover:text-primary">{job.role}</span>
                  <span class="block text-xs">{job.startDate} – {job.endDate}</span>
                </span>
                <span aria-hidden="true" class="mt-0.5 text-lg leading-none text-primary transition-transform group-open:rotate-90">›</span>
              </summary>
              <nav aria-label={`${job.role} projects`} class="space-y-1 border-t border-border/70 px-3 py-2">
                {job.projects.map((project) => (
                  <a
                    href={`#${project.id}`}
                    class="block rounded-md px-2 py-1.5 text-xs leading-4 transition-colors hover:bg-surface hover:text-primary"
                  >
                    {project.name}
                  </a>
                ))}
              </nav>
            </details>
          ))}
        </nav>
      </aside>

      <section class="min-w-0" aria-labelledby="experience-heading">
        <div class="flex flex-col gap-2 border-b border-border pb-5 sm:flex-row sm:items-baseline sm:justify-between">
          <h2 id="experience-heading" class="font-serif text-3xl font-bold tracking-tight text-fg">Experience</h2>
          <details x-on:click.outside="$el.removeAttribute('open')" class="group relative self-start text-sm sm:self-auto">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-surface/40 px-3 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary transition-colors hover:border-primary [&::-webkit-details-marker]:hidden">
              <span x-text="filterLabel()">Filter by technology</span>
              <span aria-hidden="true" class="text-base leading-none transition-transform group-open:rotate-90">›</span>
            </summary>
            <form class="absolute left-0 right-auto z-10 mt-2 max-h-[calc(100dvh-2rem)] w-[calc(100vw-3.5rem)] max-w-sm overflow-y-auto rounded-xl border border-border bg-bg p-4 shadow-xl shadow-black/10 sm:left-auto sm:right-0 sm:w-[min(22rem,calc(100vw-4rem))]">
              <button x-on:click="clearFilter" type="button" class="mb-3 block text-xs font-semibold text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary">
                Clear filter
              </button>
              <fieldset>
                <legend class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Show projects using</legend>
                <div class="mt-3 grid gap-1.5 grid-cols-2">
                  {technologies.map((technology) => (
                    <label class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-fg transition-colors hover:bg-surface">
                      <input x-model="selectedTechnologies" type="checkbox" value={technology} class="h-4 w-4 accent-primary" />
                      <span>{technology}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </form>
          </details>
        </div>

        <div class="mt-8 space-y-10">
          {jobs.map((job) => <Job job={job} />)}
        </div>
      </section>
    </div>
  </main>
</BasePage>
