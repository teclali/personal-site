---
import { Image } from "astro:assets";
import BasePage from "@/layouts/BasePage.astro";
import lakeView from "@/assets/hobby photos/lake_view.jpg";
import legoStarWars from "@/assets/hobby photos/lego_star_wars.jpg";
import saoPauloGarden from "@/assets/hobby photos/sao_paulo_botanical_garden.jpg";
import utahValley from "@/assets/hobby photos/utah_valley.jpg";
import nixosLogo from "@/assets/hobby photos/nixos-logo.svg";

const photos = [
  {
    src: lakeView,
    alt: "A mountain lake beneath a cloudy blue sky",
    position: "left-top",
    caption: "A view from my bike while commuting to work",
  },
  {
    src: legoStarWars,
    alt: "A friend and me playing Lego Star Wars",
    position: "left-bottom",
    caption: "A friend and me playing Lego Star Wars",
  },
  {
    src: saoPauloGarden,
    alt: "The botanical garden in São Paulo",
    position: "right-top",
    caption: "The botanical garden in São Paulo",
  },
  {
    src: utahValley,
    alt: "A view across Utah Valley",
    position: "right-bottom",
    caption: "A view from Khyv Peak across Utah Valley",
  },
];
---

<BasePage>
  <main class="hobbies-page">
    <section class="hobby-orbit" aria-labelledby="hobbies-heading">
      <div class="hobby-copy">
        <!-- <h1 id="hobbies-heading">Hobbies</h1> -->
        <p class="mt-40">
          My current hobbies are learning Portuguese, biking, 3D-printing, and
          working on my home server.
        </p>
        <p>
          But I'm also passionate about many things stretching from multiplayer
          video games to good urban design to geothermal greenhouses used to
          raise growing zones, and love to talk about all of them.
        </p>
      </div>

      {
        photos.map((photo) => (
          <figure class={`hobby-image ${photo.position}`}>
            <Image
              src={photo.src}
              width={260}
              alt={photo.alt}
              loading="lazy"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }

      <figure class="hobby-image nixos-logo">
        <Image
          src={nixosLogo}
          width={240}
          alt="NixOS logo"
          loading="lazy"
        />
        <figcaption>The OS I'm using for my home server</figcaption>
      </figure>
    </section>
  </main>
</BasePage>

<style>
  .hobbies-page {
    color: var(--c-fg);
    padding: 3rem 1.25rem 5rem;
  }

  .hobby-orbit {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 2rem;
    max-width: 74rem;
    margin: 0 auto;
  }

  .hobby-copy {
    max-width: 34rem;
    text-align: center;
  }

  h1 {
    margin-bottom: 1.5rem;
    color: var(--c-primary);
    font-family: var(--font-hero);
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 0.9;
  }

  p {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  p + p {
    margin-top: 1.5rem;
  }

  .hobby-image {
    width: clamp(12.5rem, 72vw, 16.25rem);
    margin: 0;
  }

  .hobby-image :global(img) {
    display: block;
    width: 100%;
    height: 12.1875rem;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    object-fit: cover;
    box-shadow: 0 0.75rem 1.5rem color-mix(in srgb, var(--c-fg) 14%, transparent);
  }

  .right-top :global(img) {
    object-position: center top;
  }

  .hobby-image figcaption {
    padding-top: 0.65rem;
    color: var(--c-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .nixos-logo :global(img) {
    background: #eeeeee;
    object-fit: contain;
    padding: 1rem;
  }

  @media (min-width: 56rem) {
    .hobbies-page {
      padding-top: 6rem;
    }

    .hobby-orbit {
      grid-template-columns: minmax(12.5rem, 16.25rem) minmax(20rem, 32rem) minmax(12.5rem, 16.25rem);
      grid-template-rows: repeat(2, auto) auto;
      column-gap: 2.25rem;
      row-gap: 2rem;
      align-items: center;
    }

    .hobby-copy {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .left-top {
      grid-column: 1;
      grid-row: 1;
      transform: translate(1.5rem, -2rem);
    }

    .left-bottom {
      grid-column: 1;
      grid-row: 2;
      transform: translate(-0.75rem, 0.5rem);
    }

    .right-top {
      grid-column: 3;
      grid-row: 1;
      transform: translate(-1.5rem, -2rem);
    }

    .right-bottom {
      grid-column: 3;
      grid-row: 2;
      transform: translate(0.75rem, 0.5rem);
    }

    .nixos-logo {
      grid-column: 2;
      grid-row: 3;
      width: 15rem;
      transform: translateY(-0.5rem);
    }
  }
</style>
