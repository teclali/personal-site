---
import { Image } from "astro:assets";
import BasePage from "@/layouts/BasePage.astro";
import lakeView from "@/assets/hobby photos/lake_view.jpg";
import legoStarWars from "@/assets/hobby photos/lego_star_wars.jpg";
import saoPauloGarden from "@/assets/hobby photos/sao_paulo_botanical_garden.jpg";
import utahValley from "@/assets/hobby photos/utah_valley.jpg";
import nixosLogo from "@/assets/hobby photos/nixos-logo.svg";

const figures = [
  {
    src: lakeView,
    alt: "A mountain lake beneath a cloudy blue sky",
    caption: "A view from my bike while commuting to work",
    figureClass:
      "lg:col-start-1 lg:row-start-1 lg:translate-x-6 lg:-translate-y-8",
    imageClass: "object-cover",
  },
  {
    src: legoStarWars,
    alt: "A friend and me playing Lego Star Wars",
    caption: "A friend and me after beating our time for 100% in Lego Star Wars",
    figureClass:
      "lg:col-start-1 lg:row-start-2 lg:-translate-x-10 lg:translate-y-2",
    imageClass: "object-cover",
  },
  {
    src: saoPauloGarden,
    alt: "The botanical garden in São Paulo",
    caption: "The botanical garden in São Paulo",
    figureClass:
      "lg:col-start-4 lg:row-start-1 lg:-translate-x-6 lg:-translate-y-8",
    imageClass: "object-cover object-top",
  },
  {
    src: utahValley,
    alt: "A view across Utah Valley",
    caption: "A view from Khyv Peak across Utah Valley",
    figureClass:
      "lg:col-start-4 lg:row-start-2 lg:translate-x-10 lg:translate-y-2",
    imageClass: "object-cover",
  },
  {
    src: nixosLogo,
    alt: "NixOS logo",
    caption: "The OS I'm using for my home server :)",
    figureClass:
      "lg:col-start-2 lg:col-span-2 lg:row-start-3 lg:w-60 lg:-translate-y-2",
    imageClass: "bg-bg object-contain p-4",
  },
];
---

<BasePage>
  <main class="px-5 pb-10 pt-12 text-fg lg:pt-24">
    <section
      class="mx-auto grid max-w-4xl xl:max-w-5xl grid-cols-1 justify-items-center gap-8 px-4 lg:grid-cols-4 lg:grid-rows-3 lg:items-center lg:gap-x-0 lg:gap-y-8"
      aria-labelledby="hobbies-heading"
    >
      <div class="max-w-lg text-center lg:col-start-2 lg:col-span-2 lg:row-span-2 lg:row-start-1 lg:self-center px-4">
        <h1 id="hobbies-heading" class="font-medium text-5xl text-primary lg:mt-30">Hobbies</h1>
        <p class="mt-10 lg:mt-20 text-lg leading-7">
          My current hobbies are learning Portuguese, biking, 3D-printing, and
          working on my home server.
        </p>
        <p class="mt-6 text-lg leading-7">
          But I'm also passionate and love to talk about many things stretching all the way from multiplayer video games to good urban design to geothermal greenhouses used to raise growing zones.
        </p>
      </div>

      {
        figures.map((figure) => (
          <figure
            class:list={[
              "w-3xs",
              figure.figureClass,
            ]}
          >
            <Image
              src={figure.src}
              width={260}
              alt={figure.alt}
              loading="lazy"
              class={`block aspect-4/3 w-full rounded-xl border border-border shadow-lg shadow-black/15 ${figure.imageClass}`}
            />
            <figcaption class="pt-2.5 text-center text-muted italic">
              {figure.caption}
            </figcaption>
          </figure>
        ))
      }
    </section>
  </main>
</BasePage>
