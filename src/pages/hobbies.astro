---
import { Image } from "astro:assets";
import BasePage from "@/layouts/BasePage.astro";
import lakeView from "@/assets/hobby photos/lake_view.jpg";
import legoStarWars from "@/assets/hobby photos/lego_star_wars.jpg";
import saoPauloGarden from "@/assets/hobby photos/sao_paulo_botanical_garden.jpg";
import utahValley from "@/assets/hobby photos/utah_valley.jpg";
import nixosLogo from "@/assets/hobby photos/nixos-logo.svg";

const photos = [
  {
    src: lakeView,
    alt: "A mountain lake beneath a cloudy blue sky",
    position: "left-top",
    caption: "A view from my bike while commuting to work",
  },
  {
    src: legoStarWars,
    alt: "A friend and me playing Lego Star Wars",
    position: "left-bottom",
    caption: "A friend and me playing Lego Star Wars",
  },
  {
    src: saoPauloGarden,
    alt: "The botanical garden in São Paulo",
    position: "right-top",
    caption: "The botanical garden in São Paulo",
  },
  {
    src: utahValley,
    alt: "A view across Utah Valley",
    position: "right-bottom",
    caption: "A view from Khyv Peak across Utah Valley",
  },
];
---

<BasePage>
  <main class="px-5 pb-10 pt-12 text-fg lg:pt-24">
    <section
      class="mx-auto grid max-w-[74rem] grid-cols-1 justify-items-center gap-8 lg:grid-cols-[minmax(12.5rem,16.25rem)_minmax(20rem,32rem)_minmax(12.5rem,16.25rem)] lg:grid-rows-[auto_auto_auto] lg:items-center lg:gap-x-9 lg:gap-y-8"
      aria-labelledby="hobbies-heading"
    >
      <div class="max-w-[34rem] text-center lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
        <h1 id="hobbies-heading" class="sr-only">Hobbies</h1>
        <p class="mt-40 text-lg leading-7">
          My current hobbies are learning Portuguese, biking, 3D-printing, and
          working on my home server.
        </p>
        <p class="mt-6 text-lg leading-7">
          But I'm also passionate and love to talk about many things stretching all the way from multiplayer video games to good urban design to geothermal greenhouses used to raise growing zones.
        </p>
      </div>

      {
        photos.map((photo) => (
          <figure
            class:list={[
              "w-[clamp(12.5rem,72vw,16.25rem)]",
              photo.position === "left-top" &&
                "lg:col-start-1 lg:row-start-1 lg:translate-x-6 lg:-translate-y-8",
              photo.position === "left-bottom" &&
                "lg:col-start-1 lg:row-start-2 lg:-translate-x-3 lg:translate-y-2",
              photo.position === "right-top" &&
                "lg:col-start-3 lg:row-start-1 lg:-translate-x-6 lg:-translate-y-8",
              photo.position === "right-bottom" &&
                "lg:col-start-3 lg:row-start-2 lg:translate-x-3 lg:translate-y-2",
            ]}
          >
            <Image
              src={photo.src}
              width={260}
              alt={photo.alt}
              loading="lazy"
              class:list={[
                "block aspect-[4/3] h-[12.1875rem] w-full rounded-xl border border-border object-cover shadow-[0_0.75rem_1.5rem_color-mix(in_srgb,var(--c-fg)_14%,transparent)]",
                photo.position === "right-top" && "object-[center_top]",
              ]}
            />
            <figcaption class="pt-2.5 text-center text-muted italic">
              {photo.caption}
            </figcaption>
          </figure>
        ))
      }

      <figure
        class="w-[clamp(12.5rem,72vw,16.25rem)] lg:col-start-2 lg:row-start-3 lg:w-60 lg:-translate-y-2"
      >
        <Image
          src={nixosLogo}
          width={240}
          alt="NixOS logo"
          loading="lazy"
          class="block aspect-[4/3] h-[12.1875rem] w-full rounded-xl border border-border bg-[#eeeeee] object-contain p-4 shadow-[0_0.75rem_1.5rem_color-mix(in_srgb,var(--c-fg)_14%,transparent)]"
        />
        <figcaption class="pt-2.5 text-center text-muted italic">
          The OS I'm using for my home server :)
        </figcaption>
      </figure>
    </section>
  </main>
</BasePage>
