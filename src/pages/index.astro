---
import "@/styles/global.css";
import BasePage from "@/layouts/BasePage.astro"
---
<BasePage>

  <span
      class="material-symbols-outlined rounded-xl border border-border bg-surface px-3 py-2 text-fg text-sm
             hover:border-[color-mix(in_oklab,var(--c-border)_80%,var(--c-primary))]
             focus:outline-none focus:ring-2 focus:ring-ring"
      >dark_mode</span
  >
  <h1 class="text-primary text-6xl font-hero -mb-4 p-0">Casey Strong,</h1>
  <h1 class="text-muted text-6xl font-hero m-0 p-0">Software Engineer</h1>
  <p class="text-fg">
      I write software that makes the world better. If you think I can do
      that with you, I'd love to hear about it
  </p>
</BasePage>
