---
import "@/styles/global.css";
import BasePage from "@/layouts/BasePage.astro"
import PageHeader from "@/components/PageHeader.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));

---
<BasePage>
  <main class="mx-auto max-w-2xl px-5 text-fg">
    <PageHeader title="Blog" id="blog-heading" />
    <ul>
      {allPosts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title} - {post.frontmatter.pubDate}</a></li>)}
    </ul>
  </main>
</BasePage>
